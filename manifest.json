{
  "manifest_version": 3,
  "name": "Polymarket Decimal Odds",
  "version": "1.1.2",
  "description": "Exibe odds decimais e estimativas USD/BRL na Polymarket.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/content/odds-calculator.js",
        "src/content/price-extractor.js",
        "src/content/currency-converter.js",
        "src/content/money-extractor.js",
        "src/content/odds-renderer.js",
        "src/content/observer.js",
        "src/content/index.js"
      ],
      "css": ["src/styles/injected.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Polymarket Decimal Odds",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
